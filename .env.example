# Get these from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, NEVER exposed to the browser.
# Used only in app/admin actions that must bypass RLS (e.g. admin verifying an ID upload).
# Supabase → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute links in confirmation emails (magic link, petition signup)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
